# Copy to .env and fill in values: cp .env.example .env
# DrawingQA loads .env from the current working directory; variables already
# set in the shell take precedence. Never commit .env.

# Required only for the `nemotron_nvidia` alias (NVIDIA-hosted API).
# Get a key at https://build.nvidia.com
NVIDIA_API_KEY=

# Local vLLM aliases (`qwen`, `nemotron`) need no key by default.
# If you set `api_key_env` for a model in configs/models.yaml (for example a
# remote authenticated endpoint), add a variable with that exact name here:
# QWEN_API_KEY=
# NEMOTRON_API_KEY=
